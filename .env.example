# Copy to .env and fill in. Never commit .env.

# LLM (OpenAI)
OPENAI_API_KEY=
# Model ID to use for the coder agent (any model that supports structured outputs)
OPENAI_MODEL=
# Optional: a different model for the reviewer agent (defaults to OPENAI_MODEL)
# OPENAI_REVIEWER_MODEL=

# Fine-grained GitHub token scoped to the target repo only
# (permissions: Contents, Pull requests, Issues: read/write; Metadata: read)
GITHUB_TOKEN=

# Target repo, e.g. your-user/autoforge-sandbox
GITHUB_REPO=

# Secret configured on the GitHub webhook (used from increment 3 onwards)
GITHUB_WEBHOOK_SECRET=

# Optional overrides (defaults shown)
# TRIGGER_LABEL=autoforge
# BRANCH_PREFIX=autoforge/
# MAX_CONTEXT_BYTES=60000
# MAX_ATTEMPTS=3                  # coder attempts per run (first try + revisions after review)
# REQUIRE_APPROVAL=false          # true: pause before opening the PR; continue with `autoforge resume <run_id>`
# CHECKPOINT_DB=.autoforge/checkpoints.sqlite
# LOG_LEVEL=INFO
