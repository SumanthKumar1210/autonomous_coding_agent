# Copy to .env and fill in. Never commit .env.

# LLM (OpenAI)
OPENAI_API_KEY=
# Model ID to use for the coder agent (any model that supports structured outputs)
OPENAI_MODEL=

# Fine-grained GitHub token scoped to the target repo only
# (permissions: Contents, Pull requests, Issues: read/write; Metadata: read)
GITHUB_TOKEN=

# Target repo, e.g. your-user/autoforge-sandbox
GITHUB_REPO=

# Secret configured on the GitHub webhook (used from increment 3 onwards)
GITHUB_WEBHOOK_SECRET=

# Optional overrides (defaults shown)
# TRIGGER_LABEL=autoforge
# BRANCH_PREFIX=autoforge/
# MAX_CONTEXT_BYTES=60000
# LOG_LEVEL=INFO
